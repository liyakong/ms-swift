# syntax=docker/dockerfile:1
#
# NPU (Ascend 910B / aarch64) image for ms-swift with elastic-relay support.
#
# Build context layout (same as before): this Dockerfile sits next to an `upload/`
# directory containing this repository plus:
#   - requirements.txt
#   - entrypoint.sh
#   - deploy/constraints-npu.txt, deploy/check_npu_core.py, deploy/opcheck.py, deploy/build_check.py
#   - swanboard-*.whl / swanlab-*.whl
#
# Build (BuildKit not required: no heredocs are used):
#   BASE_TAG=quay.io/ascend/vllm-ascend:v0.23.0
#   BASE_REF="$(docker image inspect "$BASE_TAG" --format '{{index .RepoDigests 0}}')"
#   docker build --platform=linux/arm64 \
#     --build-arg BASE_IMAGE="$BASE_REF" --build-arg FLA_VERSION=0.5.2 \
#     -f Dockerfile.npu -t <registry>/ms-swift-npu-arm-elastic:4.5.2-fla052 .
#
# Notes:
#   - keep the verified base image pinned by digest; do not change the NPU stack.
#   - `deploy/constraints-npu.txt` (tracked) pins only the NPU-critical stack; it
#     constrains versions, it does not install anything. Everything else resolves
#     against it (e.g. matplotlib/librosa pick numpy-1.x-compatible versions).
#   - flash-linear-attention / fla-core are installed with --no-deps so pip cannot
#     touch torch / vllm / triton-ascend.

ARG BASE_IMAGE=quay.io/ascend/vllm-ascend:v0.23.0
FROM ${BASE_IMAGE}

SHELL ["/bin/bash", "-o", "pipefail", "-c"]
WORKDIR /

ARG ARCH=aarch64
ARG FLA_VERSION=0.5.2
ARG PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

ENV LANG=C.UTF-8 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# ---- Ascend base paths ----
ENV ASCEND_TOOLKIT_HOME=/usr/local/Ascend/ascend-toolkit/latest

ENV ASCEND_AICPU_PATH=${ASCEND_TOOLKIT_HOME} \
    ASCEND_OPP_PATH=${ASCEND_TOOLKIT_HOME}/opp \
    ASCEND_HOME_PATH=${ASCEND_TOOLKIT_HOME} \
    TOOLCHAIN_HOME=${ASCEND_TOOLKIT_HOME}/toolkit

# ---- runtime switches ----
ENV VLLM_ASCEND_ENABLE_NZ=0 \
    VLLM_ASCEND_USE_FUSED_GDN_UPDATE=0

# ---- custom operator path: must point at the concrete vendor dir ----
ENV VLLM_ASCEND_CUSTOM_VENDOR=/vllm-workspace/vllm-ascend/vllm_ascend/_cann_ops_custom/vendors/custom_transformer

ENV ASCEND_CUSTOM_OPP_PATH=${VLLM_ASCEND_CUSTOM_VENDOR}${ASCEND_CUSTOM_OPP_PATH:+:${ASCEND_CUSTOM_OPP_PATH}}

ENV LD_LIBRARY_PATH=${VLLM_ASCEND_CUSTOM_VENDOR}/op_api/lib:\
/usr/local/Ascend/driver/lib64:\
/usr/local/Ascend/driver/lib64/common:\
/usr/local/Ascend/driver/lib64/driver:\
${ASCEND_TOOLKIT_HOME}/lib64:\
${ASCEND_TOOLKIT_HOME}/lib64/plugin/opskernel:\
${ASCEND_TOOLKIT_HOME}/lib64/plugin/nnengine:\
${ASCEND_TOOLKIT_HOME}/opp/built-in/op_impl/ai_core/tbe/op_tiling/lib/linux/${ARCH}:\
/usr/local/lib${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}

# /swift (this repo's code) first; keep the base image PYTHONPATH afterwards.
ENV PYTHONPATH=/:${ASCEND_TOOLKIT_HOME}/python/site-packages:${ASCEND_TOOLKIT_HOME}/opp/built-in/op_impl/ai_core/tbe${PYTHONPATH:+:${PYTHONPATH}}

ENV PATH=${ASCEND_TOOLKIT_HOME}/bin:${ASCEND_TOOLKIT_HOME}/compiler/ccec_compiler/bin:${ASCEND_TOOLKIT_HOME}/tools/ccec_compiler/bin:${PATH}

# upload/ contains swift/, project install files, requirements.txt,
# deploy/constraints-npu.txt, entrypoint.sh and the swanboard/swanlab wheels.
COPY upload /

# NPU-stack version lock (tracked in the repo; not manually copied into upload/).
COPY upload/deploy/constraints-npu.txt /constraints-npu.txt

# ---- build/runtime check scripts ----
# Shipped as files (not `RUN ... <<'PY'` heredocs) so the build works without BuildKit.
COPY upload/deploy/check_npu_core.py /opt/check-npu-core.py
COPY upload/deploy/opcheck.py /opt/opcheck.py
COPY upload/deploy/build_check.py /opt/build-check.py

# Confirm the base image is the verified one before installing anything.
RUN python /opt/check-npu-core.py

# ---- application dependencies ----
# Do not unconditionally upgrade pip and do not reinstall the base image's
# torch / vllm / triton.
RUN python -m pip install --no-cache-dir \
        -i "${PIP_INDEX_URL}" \
        -c /constraints-npu.txt \
        /swanboard-*.whl /swanlab-*.whl && \
    python -m pip install --no-cache-dir \
        -i "${PIP_INDEX_URL}" \
        -c /constraints-npu.txt \
        -r /requirements.txt

# ---- install FLA separately: --no-deps so pip cannot touch the NPU stack ----
RUN python -m pip install --no-cache-dir \
        --only-binary=:all: \
        --no-deps \
        -i "${PIP_INDEX_URL}" \
        -c /constraints-npu.txt \
        "fla-core==${FLA_VERSION}" \
        "flash-linear-attention[npu]==${FLA_VERSION}"

# ---- install this repository (elastic_relay included) editable, no deps ----
RUN python -m pip install --no-cache-dir \
        --no-deps \
        --no-build-isolation \
        -c /constraints-npu.txt \
        -e /

# ---- build-time acceptance: metadata + filesystem, no NPU init ----
RUN python /opt/check-npu-core.py
RUN python /opt/build-check.py

# Keep the final package list for auditing / diffing.
RUN python -m pip list --format=freeze > /opt/image-packages.txt

RUN sed -i 's/\r$//' /entrypoint.sh && chmod +x /entrypoint.sh

# K8s: use ENTRYPOINT (not CMD) so entrypoint.sh always runs:
#   - Pod sets only `args:`  -> overrides CMD, ENTRYPOINT is kept -> entrypoint.sh runs
#   - Pod sets `command:`    -> overrides ENTRYPOINT -> bypassed (only Dockerfile ENV applies)
# The platform should therefore pass the training command via `args:`.
# With no args (plain `docker run`), entrypoint.sh falls back to a debug shell.
ENTRYPOINT ["/entrypoint.sh"]
CMD []

