# GPU image for ms-swift with elastic-relay support.
#
# Build (run from the repository root):
#   docker build -f Dockerfile.gpu -t <registry>/ms-swift-4.5.2-elastic:gpu .
#
# Verify:
#   docker run --gpus all --rm -it <image> \
#     python -c "import swift, swift.elastic_relay; print(swift.__file__); print(swift.elastic_relay.__file__)"
FROM modelscope-registry.cn-hangzhou.cr.aliyuncs.com/modelscope-repo/modelscope:ubuntu22.04-cuda13.0.3-py312-torch2.11.0-vllm0.23.0-modelscope1.38.1-swift4.4.1

# Keep the layout identical to the NPU image: code at /swift, project files at /, and
# installed editable from /. WORKDIR is / so both images start in the same directory.
WORKDIR /

# Bring in this repository (it contains swift/elastic_relay/).
COPY upload /

# Replace the base image's pre-installed swift with this repository so that
# `swift.elastic_relay` is importable in every process (including torchrun workers).
# --no-deps keeps the base image's torch / vllm / torch-npu stack untouched.
RUN pip3 uninstall -y ms_swift >/dev/null 2>&1 || true \
    && pip3 install --no-cache-dir -e / --no-deps

# Install the same framework requirements as the NPU image (single source of truth:
# requirements/framework.txt -> transformers==5.12.1, deepspeed==0.19.7, pyarrow==21.0.0, ...).
# NOTE: this may upgrade transformers/datasets and conflict with the base image's vLLM pin.
# SFT/DPO/PT (and GRPO with use_vllm=false) are fine; vLLM rollout needs a compatible vllm build.
RUN pip3 install --no-cache-dir -r /requirements/framework.txt

# Video decoding is used by multimodal/video templates but is not in framework.txt.
RUN pip3 install --no-cache-dir decord

# Build-time sanity check: elastic_relay present and Qwen3.5 supported.
RUN python3 -c "import swift, swift.elastic_relay; \
    print('swift:', swift.__file__); \
    print('elastic_relay:', swift.elastic_relay.__file__)" \
    && python3 -c "import transformers; print('transformers', transformers.__version__)" \
    && python3 -c "import deepspeed; print('deepspeed', deepspeed.__version__)" \
    && python3 -c "from transformers import Qwen3_5ForConditionalGeneration; print('Qwen3_5 class ok')"

CMD ["bash"]
